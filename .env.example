# CHANGE Foundation — Environment Variables Template
# Copy this file to `.env` and fill in the values for your environment.

# ==============================================================================
# 1. Supabase Backend (Contact Form & Newsletter Storage)
# ==============================================================================
# Create a project at https://supabase.com and copy your project URL & public anon key.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# ==============================================================================
# 2. Google Gemini AI (Multilingual Assistant ChatBot)
# ==============================================================================
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================================================
# 3. Optional Express Backend Server (if running local Node proxy)
# ==============================================================================
PORT=5000
CORS_ORIGIN=http://localhost:5173

